[Unit]
Description=VolunteerPlus Dashboard (Telegram bot + API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=innohack
Group=innohack
WorkingDirectory=/opt/innohack
EnvironmentFile=/opt/innohack/.env
ExecStart=/opt/innohack/.venv/bin/python bot/main.py
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
