[Unit]
Description=Beeline Volunteer+ Dashboard (Telegram bot + API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mmggaas3
Group=mmggaas3
WorkingDirectory=/home/mmggaas3/beeline_project
EnvironmentFile=/home/mmggaas3/beeline_project/.env
ExecStart=/home/mmggaas3/beeline_project/.venv/bin/python bot/main.py
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
